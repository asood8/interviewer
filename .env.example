# Copy this file to .env and fill in your key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the Claude model
# INTERVIEWER_MODEL=claude-opus-5

# Optional: speech-to-text settings
# WHISPER_MODEL=small.en     # base.en is faster, medium.en is more accurate
# WHISPER_DEVICE=cpu         # cuda for an NVIDIA GPU
